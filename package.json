{
  "name": "software-factory-starter",
  "version": "0.1.0",
  "private": true,
  "description": "A small invoice library wrapped in a brakes-first AI software factory (GitHub Issues + Actions + Claude Code).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run test:ratchet",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:report": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:ratchet": "node scripts/check-test-ratchet.mjs",
    "test:holdout": "vitest run --config vitest.holdout.config.ts",
    "invoice": "node --experimental-strip-types src/cli.ts",
    "factory:metrics": "node scripts/factory-metrics.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.20.0",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
  }
}
